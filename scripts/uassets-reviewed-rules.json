  "note": "Reviewed subset only; no automatic filter-language import. Name/value patterns are fully anchored at runtime. The Drip value condition is deliberately narrower: the entire value must be alphanumeric. Global removals inherit ClearURLs global exceptions when generated. Source rule selections and transformations are GPL-3.0 data.",
  "parameterRules": [
    {
      "id": "click-identifiers-1",
      "urlPattern": ".*",
      "namePattern": "(?:gad_source|gad_campaignid|ttclid|pjclid|tgclid|cjevent|cjdata|fbadid|fb_comment_id|clckid|ymclid|ysclid|ym_tracking_id|hss_channel|sfmc_id)",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "click-identifiers-2",
      "urlPattern": ".*",
      "namePattern": "(?:sfmc_activityid|hsa_acc|hsa_ad|hsa_cam|hsa_grp|hsa_kw|hsa_la|hsa_mt|hsa_net|hsa_ol|hsa_src|hsa_tgt|hsa_ver|bsft_clkid|bsft_eid)",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "click-identifiers-3",
      "urlPattern": ".*",
      "namePattern": "(?:bsft_mid|bsft_uid|bsft_aaid|bsft_ek)",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "facebook-share",
      "urlPattern": "^https?://(?:[a-z0-9-]+\\.)*facebook\\.com(?=[/?#]|$)",
      "namePattern": "(?:rdid|share_url)",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "instagram-share",
      "urlPattern": "^https?://(?:[a-z0-9-]+\\.)*instagram\\.com(?=[/?#]|$)",
      "namePattern": "ig_rid",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "reddit-share",
      "urlPattern": "^https?://(?:[a-z0-9-]+\\.)*reddit\\.com(?=[/?#]|$)",
      "namePattern": "(?:ref|\\$web_only|web_only|deep_link)",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "spotify-share",
      "urlPattern": "^https?://open\\.spotify\\.com(?=[/?#]|$)",
      "namePattern": "(?:pi|dlsi)",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "tiktok-share",
      "urlPattern": "^https?://(?:[a-z0-9-]+\\.)*tiktok\\.com(?=[/?#]|$)",
      "namePattern": "share_region",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "youtube-short-link",
      "urlPattern": "^https?://(?:[a-z0-9-]+\\.)*youtu\\.be(?=[/?#]|$)/[^/?#]+/?(?=[?#]|$)",
      "namePattern": "is",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "youtube-live",
      "urlPattern": "^https?://(?:[a-z0-9-]+\\.)*youtube\\.com(?=[/?#]|$)/live/[^/?#]+/?(?=[?#]|$)",
      "namePattern": "is",
      "action": "remove",
      "exceptions": []
    },
    {
      "id": "drip-value-condition",
      "urlPattern": ".*",
      "namePattern": "__s",
      "action": "remove",
      "exceptions": [],
      "valuePattern": "[A-Za-z0-9]{6,}"
    },
    {
